generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Car {
  id           Int      @id @default(autoincrement())
  brand        String
  model        String
  year         Int
  price        Int
  category     String
  fuelType     String
  transmission String
  color        String
  mileage      Int      @default(0)
  rating       Float    @default(0)
  imageUrl     String
  description  String?
  userId       String?
  createdAt    DateTime @default(now())

  @@index([userId])
}